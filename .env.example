# ==============================================================================
# SAPVIK Website - Environment Variables Reference (.env.example)
#
# Copy this file to `.env` (for Astro client build) and `.dev.vars` (for local Wrangler dev).
# In production, configure these in Cloudflare Pages Dashboard:
# Workers & Pages > sapvik-main > Settings > Environment variables
# ==============================================================================

# --- Cloudflare Turnstile Bot Protection ---
# Public site key embedded into client islands (Scanner and ContactForm)
PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA_EXAMPLE_SITE_KEY"

# Server-side secret key used by functions/api/audit.js and functions/api/contact.js
TURNSTILE_SECRET_KEY="0x4AAAAAA_EXAMPLE_SECRET_KEY"

# --- Edge Password Gate & Redirects (functions/_middleware.js) ---
# Set custom passcode for preview environments, or "DISABLE" for public production
SITE_PASSWORD="CHANGE_ME_LONG_RANDOM"

# Set to "true" to redirect *.pages.dev hosts to sapvik.com (only after DNS points to sapvik.com).
# If absent or false, *.pages.dev serves directly with X-Robots-Tag: noindex.
REDIRECT_ALLOW="false"

# --- Brevo Transactional Email & Lead Intake (functions/api/contact.js) ---
# Brevo SMTP API Key (xkeysib-...)
BREVO_API_KEY="xkeysib-example-api-key-do-not-commit-real-key"

# Verified sender email configured in Brevo
BREVO_SENDER_EMAIL="growth@sapvik.com"

# Team inbox destination where customer lead alerts are received
NOTIFICATION_EMAIL="leads@sapvik.com"

# (Optional) Brevo Contact List ID for leads opting into marketing
BREVO_MARKETING_LIST_ID="2"

PAGESPEED_API_KEY=""

# --- (Optional) Redundant Webhook Intake ---
# External CRM/Slack/Discord webhook endpoint
# LEAD_WEBHOOK_URL="https://hooks.slack.com/services/EXAMPLE/WEBHOOK/URL"

# --- (Optional) Analytics & Tag Management ---
# Google Tag Manager Container ID
# PUBLIC_GTM_ID="GTM-XXXXXXX"

# Google Analytics 4 Measurement ID
# PUBLIC_GA4_ID="G-XXXXXXXXXX"
