---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found (404) | SAPVIK Growth"
  description="The requested page could not be found on SAPVIK. Explore our website development, Google Business Profile, and digital growth services."
  noindex={true}
>
  <div class="error-page section">
    <div class="container error-container">
      <div class="error-card framed-card">
        <span class="mono-label" style="color: var(--c-vermilion);">HTTP 404 Status</span>
        <h1 class="error-title">Page Not Found</h1>
        <p class="error-desc">
          The URL you requested does not exist, was moved, or is temporarily unavailable. 
          Use the navigational routes below to explore our services or return to the main platform.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary btn-sm">
            <span>&larr; Return to Home</span>
          </a>
          <a href="/#services" class="btn btn-secondary btn-sm">
            <span>Explore Services</span>
          </a>
          <a href="/#contact" class="btn btn-secondary btn-sm">
            <span>Contact Us</span>
          </a>
        </div>

        <div class="error-service-links">
          <div class="mono-label" style="margin-bottom: 0.75rem;">Direct Service Shortcuts:</div>
          <ul class="error-links-list">
            <li><a href="/services/website-development">&rarr; Website Development</a></li>
            <li><a href="/services/google-business-profile-management">&rarr; Google Business Profile Management</a></li>
            <li><a href="/services/search-engine-optimization">&rarr; Search Engine Optimization (SEO)</a></li>
            <li><a href="/services/google-ads-meta-ads">&rarr; Google &amp; Meta Ads Management</a></li>
            <li><a href="/blog">&rarr; Insights &amp; Engineering Blog</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .error-page {
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    min-height: calc(100vh - var(--header-h) - 300px);
    display: flex;
    align-items: center;
  }
  .error-container {
    max-width: 680px;
    width: 100%;
  }
  .error-card {
    padding: clamp(2rem, 5vw, 3rem);
  }
  .error-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.15;
  }
  .error-desc {
    color: var(--c-text-secondary);
    line-height: 1.65;
    font-size: 1rem;
    margin-bottom: 2rem;
  }
  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
  }
  .error-service-links {
    border-top: 1px dashed var(--c-border);
    padding-top: 1.5rem;
  }
  .error-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.5rem 1rem;
  }
  .error-links-list a {
    font-size: 0.88rem;
    color: var(--c-text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .error-links-list a:hover {
    color: var(--c-vermilion);
  }
</style>
