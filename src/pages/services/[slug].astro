---
import Base from '../../layouts/Base.astro';
import { SERVICES, type ServiceItem } from '../../config/services';

export function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: { service: ServiceItem; isLegacy?: boolean } }> = [];

  for (const service of SERVICES) {
    // Primary canonical route
    paths.push({
      params: { slug: service.slug },
      props: { service, isLegacy: false }
    });

    // Legacy slug routes (to prevent 404s on static hosts)
    if (service.legacySlugs) {
      for (const legacy of service.legacySlugs) {
        paths.push({
          params: { slug: legacy },
          props: { service, isLegacy: true }
        });
      }
    }
  }

  return paths;
}

interface Props {
  service: ServiceItem;
  isLegacy?: boolean;
}

const { service } = Astro.props;
const otherServices = SERVICES.filter(s => s.id !== service.id);

const outcomeMap: Record<string, string> = {
  'websites': 'Higher Conversion Rate & Core Web Vitals',
  'gmb': 'Inbound Calls & Local 3-Pack Discovery',
  'seo': 'Organic Search Impressions & Commercial Rankings',
  'promotions': 'Qualified Commercial Leads & Direct Attribution',
  'media': 'Brand Authority & Commercial Audience Trust',
  'apps': 'Workflow Efficiency & Operational Hours Saved',
  'branding': 'Market Credibility & Visual Distinction'
};

const canonicalUrl = `https://sapvik.com/services/${service.slug}`;

// Structured Data
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sapvik.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://sapvik.com/#services"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.name,
      "item": canonicalUrl
    }
  ]
};

const serviceSchema = {
  "@type": "Service",
  "name": service.name,
  "serviceType": service.name,
  "description": service.description,
  "provider": {
    "@id": "https://sapvik.com/#organization"
  },
  "areaServed": {
    "@type": "Country",
    "name": "India"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `${service.name} Deliverables`,
    "itemListElement": service.deliverables.map((item, index) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": item
      }
    }))
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": service.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const pageSchemas = [breadcrumbSchema, serviceSchema, faqSchema];
---

<Base
  title={`${service.name} in India | SAPVIK`}
  description={service.metaDescription}
  canonical={canonicalUrl}
  schema={pageSchemas}
>
  <article class="service-detail-page">
    <div class="container">
      
      <!-- Editorial Breadcrumb Navigation -->
      <nav class="breadcrumb-bar" aria-label="Breadcrumbs" style="margin-bottom: 1.5rem;">
        <ol style="list-style: none; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-family: var(--font-mono); color: var(--c-text-muted); padding: 0; margin: 0; flex-wrap: wrap;">
          <li><a href="/" style="color: inherit; text-decoration: none;">HOME</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#services" style="color: inherit; text-decoration: none;">SERVICES</a></li>
          <li aria-hidden="true">/</li>
          <li style="color: var(--c-vermilion); font-weight: 700;" aria-current="page">{service.code} &bull; {service.name.toUpperCase()}</li>
        </ol>
      </nav>

      <!-- Section Header -->
      <div class="section-head" style="margin-bottom: 2.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
          <span class="badge">{service.code}</span>
          <span class="mono-label">Pillar of Execution &bull; Pan-India Delivery</span>
        </div>
        <h1 class="section-title">
          {service.name}<span class="vermilion-square" aria-hidden="true"></span>
        </h1>
        <p class="section-desc" style="max-width: 780px;">
          {service.headline}
        </p>
      </div>

      <!-- Two-Column Editorial Layout -->
      <div class="service-details-grid">
        
        <!-- Left Column: Narrative, Who It's For, Methodology, Deliverables, FAQs -->
        <div class="details-main-column">
          
          <!-- Box 1: Technical Overview -->
          <div class="frame-box" style="padding: 2.25rem 2rem; margin-bottom: 2rem;">
            <span class="mono-label" style="display: block; margin-bottom: 0.5rem; color: var(--c-vermilion);">
              CAPABILITY OVERVIEW & ARCHITECTURE
            </span>
            <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--c-text-primary); margin-bottom: 1rem;">
              Commercial Growth Architecture
            </h2>
            <p style="font-size: 1.05rem; color: var(--c-text-secondary); line-height: 1.7; margin-bottom: 1.75rem;">
              {service.description}
            </p>

            <!-- Who This Is Engineered For -->
            <div style="border-top: 1px dashed var(--c-border); padding-top: 1.5rem; margin-bottom: 1.75rem;">
              <span class="mono-label" style="display: block; margin-bottom: 0.85rem; color: var(--c-text-primary);">
                WHO THIS SERVICE IS ENGINEERED FOR
              </span>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.85rem; padding: 0; margin: 0;">
                {service.whoItsFor.map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.95rem; color: var(--c-text-secondary); line-height: 1.55;">
                    <span style="color: var(--c-vermilion); font-weight: 800; line-height: 1.2;">&bull;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Execution Methodology -->
            <div style="border-top: 1px dashed var(--c-border); padding-top: 1.5rem; margin-bottom: 1.75rem;">
              <span class="mono-label" style="display: block; margin-bottom: 0.85rem; color: var(--c-text-primary);">
                EXECUTION METHODOLOGY & MILESTONES
              </span>
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                {service.methodology.map((m) => (
                  <div style="background: var(--c-bg-subtle, #F8F9FA); border: 1px solid var(--c-border); padding: 1.15rem 1.25rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                      <span style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: var(--c-vermilion);">{m.step}.</span>
                      <h4 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--c-text-primary); margin: 0;">{m.title}</h4>
                    </div>
                    <p style="font-size: 0.9rem; color: var(--c-text-secondary); line-height: 1.55; margin: 0;">
                      {m.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Deliverables -->
            <div style="border-top: 1px dashed var(--c-border); padding-top: 1.5rem; margin-bottom: 1.5rem;">
              <span class="mono-label" style="display: block; margin-bottom: 0.85rem;">
                CORE DELIVERABLES & SCOPE OF EXECUTION
              </span>
              <ul class="service-deliverables" style="margin-bottom: 0;">
                {service.deliverables.map((item) => (
                  <li class="deliverable-item">
                    <span class="item-dash">—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div style="border-top: 1px dashed var(--c-border); padding-top: 1.25rem;">
              <a href="/#services" class="btn btn-secondary btn-sm" style="font-size: 0.82rem;">
                <span>&larr; View All Growth Capabilities</span>
              </a>
            </div>
          </div>

          <!-- Box 2: Dedicated FAQs Section -->
          <div class="frame-box" style="padding: 2.25rem 2rem; margin-bottom: 2rem;">
            <span class="mono-label" style="display: block; margin-bottom: 0.5rem; color: var(--c-vermilion);">
              FREQUENTLY ASKED QUESTIONS
            </span>
            <h2 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--c-text-primary); margin-bottom: 1.5rem;">
              Frequently Asked Questions About {service.name}
            </h2>

            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
              {service.faqs.map((faq, idx) => (
                <div style="border-bottom: 1px dashed var(--c-border); padding-bottom: 1.25rem;">
                  <h3 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--c-text-primary); margin-bottom: 0.5rem; line-height: 1.4;">
                    {faq.question}
                  </h3>
                  <p style="font-size: 0.92rem; color: var(--c-text-secondary); line-height: 1.6; margin: 0;">
                    {faq.answer}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <!-- Box 3: Strategic Discovery Box -->
          <div class="frame-box discovery-box">
            <span class="mono-label" style="color: var(--c-vermilion); display: block; margin-bottom: 0.35rem;">
              COMMERCIAL GROWTH PARTNERSHIP &bull; {service.code}
            </span>
            <h3 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--c-text-primary); margin-bottom: 0.4rem;">
              Scale Your {service.name} Pipeline
            </h3>
            <p style="color: var(--c-text-secondary); font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.5rem;">
              Book an initial technical architecture review with our senior team. Zero upfront lock-in, client-held platform ownership, and strict response SLAs.
            </p>
            <div class="discovery-cta-group" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <a href="/#contact" class="btn btn-vermilion btn-lg">
                <span>Request Growth Diagnostic</span>
                <span>&rarr;</span>
              </a>
              <a href={`https://wa.me/918800592147?text=${encodeURIComponent(`Hi SAPVIK, I'd like to discuss ${service.name}.`)}`} target="_blank" rel="noopener" class="btn btn-secondary btn-lg">
                <span>WhatsApp Direct</span>
              </a>
            </div>
          </div>

        </div>

        <!-- Right Column: Telemetry, SLA, Related Pillars -->
        <div class="details-sidebar-column">
          
          <!-- Card 1: Key Metric Target -->
          <div class="frame-box" style="padding: 1.75rem; margin-bottom: 1.75rem;">
            <span class="mono-label" style="color: var(--c-vermilion); display: block; margin-bottom: 0.35rem;">
              PRIMARY OUTCOME
            </span>
            <h3 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--c-text-primary); margin-bottom: 0.5rem;">
              {outcomeMap[service.id] || service.metricsFocus}
            </h3>
            <p style="font-size: 0.88rem; color: var(--c-text-muted); line-height: 1.55;">
              Evaluated through bi-weekly performance debriefs focused on verified commercial inquiries, call logs, and customer acquisition.
            </p>
          </div>

          <!-- Card 2: Operational Standards -->
          <div class="frame-box" style="padding: 1.75rem; margin-bottom: 1.75rem;">
            <span class="mono-label" style="display: block; margin-bottom: 0.75rem;">
              OPERATIONAL COMMITMENTS
            </span>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem; color: var(--c-text-secondary); padding: 0; margin: 0;">
              <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--c-vermilion); font-weight: 800; line-height: 1.2;">&bull;</span>
                <span><strong>&lt;24h Turnaround SLA:</strong> Rapid diagnostic response on incoming architecture reviews.</span>
              </li>
              <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--c-vermilion); font-weight: 800; line-height: 1.2;">&bull;</span>
                <span><strong>100% Asset Ownership:</strong> You retain full DNS, code repository, and ad account administration.</span>
              </li>
              <li style="display: flex; align-items: flex-start; gap: 0.5rem;">
                <span style="color: var(--c-vermilion); font-weight: 800; line-height: 1.2;">&bull;</span>
                <span><strong>Direct Platform Invoicing:</strong> Zero agency percentage markups on third-party ad spend.</span>
              </li>
            </ul>
          </div>

          <!-- Card 3: Other Capabilities -->
          <div class="frame-box" style="padding: 1.75rem;">
            <span class="mono-label" style="display: block; margin-bottom: 0.75rem;">
              OTHER GROWTH CAPABILITIES
            </span>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; padding: 0; margin: 0;">
              {otherServices.map((other) => (
                <li>
                  <a href={`/services/${other.slug}`} class="related-pillar-link">
                    <span>{other.name}</span>
                    <span style="color: var(--c-vermilion);">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

        </div>

      </div>

    </div>
  </article>
</Base>

<style>
  .service-detail-page {
    padding-top: calc(var(--header-h) + 2.5rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .service-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .service-details-grid {
      grid-template-columns: 1.9fr 1fr;
    }
  }

  .discovery-box {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    border-left: 4px solid var(--c-vermilion);
    box-sizing: border-box;
  }

  @media (max-width: 640px) {
    .service-detail-page {
      padding-top: calc(58px + 1.25rem);
      padding-bottom: 3.5rem;
    }

    .service-details-grid {
      gap: 1.25rem;
    }

    .details-main-column .frame-box,
    .details-sidebar-column .frame-box {
      padding: 1.25rem 0.95rem !important;
      margin-bottom: 1.25rem !important;
      box-sizing: border-box !important;
    }

    .discovery-box {
      padding: 1.25rem 0.95rem !important;
      border-left-width: 3px !important;
    }

    .discovery-box .mono-label {
      font-size: 0.66rem !important;
      word-break: break-word;
      line-height: 1.35;
    }

    .discovery-box h3 {
      font-size: clamp(1.15rem, 5vw, 1.35rem) !important;
      line-height: 1.25 !important;
      margin-bottom: 0.35rem !important;
    }

    .discovery-box p {
      font-size: 0.84rem !important;
      line-height: 1.5 !important;
      margin-bottom: 1.15rem !important;
    }

    .discovery-cta-group {
      flex-direction: column !important;
      width: 100% !important;
      gap: 0.5rem !important;
    }

    .discovery-cta-group .btn {
      width: 100% !important;
      justify-content: center !important;
      min-height: 44px !important;
      padding: 0.75rem 0.85rem !important;
      font-size: 0.84rem !important;
      box-sizing: border-box !important;
    }
  }

  .related-pillar-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-text-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--c-border);
    transition: color 0.15s ease, padding-left 0.15s ease;
    text-decoration: none;
  }

  .related-pillar-link:hover {
    color: var(--c-vermilion);
    padding-left: 0.25rem;
  }
</style>
