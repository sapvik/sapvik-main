---
import Base from '../layouts/Base.astro';
import { SERVICES } from '../config/services';
import ServiceCard from '../components/ServiceCard.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Scanner from '../components/islands/Scanner.tsx';
import Heatmap from '../components/islands/Heatmap.tsx';
import Calculator from '../components/islands/Calculator.tsx';
import ContactForm from '../components/islands/ContactForm.tsx';
---

<Base
  title="SAPVIK | Website Development, Google Business Profile & Digital Marketing in India"
  description="SAPVIK engineers high-speed websites, Google Business Profile local dominance, targeted Google Ads & Meta Ads campaigns, and organic SEO across India."
  loadTurnstile={true}
>
  <!-- HERO SECTION: VALUE PROPOSITION + LIVE DIAGNOSTIC CONSOLE -->
  <section class="hero-section" id="home" aria-label="Introduction">
    <div class="container">
      <div class="hero-grid">
        
        <!-- Content Left -->
        <div class="hero-content">
          <div class="hero-meta-strip">
            <span class="badge">GROWTH PARTNER</span>
            <span class="mono-label">Pan-India Client Delivery</span>
          </div>

          <h1 class="hero-title">
            More Calls, Leads and Revenue from Your Digital Presence<span class="vermilion-square" aria-hidden="true"></span>
          </h1>

          <p class="hero-subtitle">
            We engineer high-speed websites, build local Google Business Profile dominance, run targeted ad campaigns, and develop custom apps—with clear, measurable business returns.
          </p>

          <div class="hero-cta-group">
            <a href="#contact" class="btn btn-vermilion btn-lg">
              <span>Request Growth Audit</span>
              <span>&rarr;</span>
            </a>
            <a href="#services" class="btn btn-secondary btn-lg">
              <span>Explore Capabilities</span>
            </a>
          </div>

          <!-- Verified Metrics Bar -->
          <div class="hero-metrics-bar">
            <div class="hero-metric-item">
              <span class="hero-metric-num">Growth Pillars</span>
              <span class="hero-metric-label">Unified Growth Engine</span>
            </div>
            <div class="hero-metric-item">
              <span class="hero-metric-num">Top 3</span>
              <span class="hero-metric-label">Local GMB Target</span>
            </div>
            <div class="hero-metric-item">
              <span class="hero-metric-num">&lt;24h</span>
              <span class="hero-metric-label">Audit Turnaround SLA</span>
            </div>
          </div>
        </div>

        <!-- Hero Right: Live Technical Diagnostic Console -->
        <div class="hero-visual">
          <Scanner client:load />
        </div>

      </div>
    </div>
  </section>

  <!-- SERVICES SECTION (6 CANONICAL PILLARS) -->
  <section class="section-pad" id="services" aria-label="Services Offered">
    <div class="container">
      <div class="section-head">
        <span class="mono-label">Pillars of Execution</span>
        <h2 class="section-title">Six Integrated Growth Capabilities</h2>
        <p class="section-desc">
          We operate across the entire customer acquisition journey—from the first Google search to the final commercial booking.
        </p>
      </div>

      <div class="services-framed-grid" id="servicesGrid">
        {SERVICES.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>

      <!-- Mobile & Touch Carousel Pagination Dots -->
      <div class="services-scroll-pagination" id="servicesScrollDots" role="tablist" aria-label="Services carousel navigation">
        {SERVICES.map((service, index) => (
          <button
            type="button"
            class={`services-scroll-dot ${index === 0 ? 'active' : ''}`}
            data-index={index}
            role="tab"
            aria-label={`Go to slide ${index + 1}: ${service.name}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex="0"
          >
            <span class="dot-indicator"></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- INTERACTIVE GOOGLE MAPS 3-PACK GEO-GRID HEATMAP (DEMONSTRATION) -->
  <section class="section-pad" id="heatmap" aria-label="Local Map Ranking Simulator">
    <div class="container">
      <div class="section-head">
        <span class="mono-label">Local Search Visibility</span>
        <h2 class="section-title">Google Maps 3-Pack Ranking Demonstration</h2>
        <p class="section-desc">
          Local customer searches are proximity-based. See how geographic profile optimization expands your reach beyond your doorstep.
        </p>
      </div>

      <Heatmap client:visible />
    </div>
  </section>

  <!-- GROWTH ESTIMATOR & ROI CALCULATOR (TRANSPARENT MODEL) -->
  <section class="section-pad" id="calculator" aria-label="Growth Simulator and ROI Calculator">
    <div class="container">
      <div class="section-head">
        <span class="mono-label">Illustrative Modeler</span>
        <h2 class="section-title">Illustrative Growth Simulator</h2>
        <p class="section-desc">
          Explore directional monthly impressions and inquiries based on benchmark models and your target service configuration.
        </p>
      </div>

      <Calculator client:visible />
    </div>
  </section>

  <!-- EXECUTION PROCESS (4 STAGES) -->
  <Process />

  <!-- PROOF & VALUES SECTION -->
  <section class="section-pad" id="proof" aria-label="Client Proof and Values">
    <div class="container">
      <div class="section-head">
        <span class="mono-label">Accountability</span>
        <h2 class="section-title">Built on Clarity and Measurable Standards</h2>
        <p class="section-desc">
          Growth marketing without ambiguous jargon or unverifiable claims. Every operational commitment is documented, auditable, and backed by contractual SLA.
        </p>
      </div>

      <div class="proof-layout">
        <div class="values-column">
          <div class="value-row">
            <h3 class="value-heading">Candor Over Promises</h3>
            <p class="value-desc">If a service or channel will not generate positive return on your capital, we tell you directly.</p>
          </div>
          <div class="value-row">
            <h3 class="value-heading">Engineering Discipline</h3>
            <p class="value-desc">High-speed websites, clean tracking infrastructure, and resilient code built to enterprise standards.</p>
          </div>
          <div class="value-row">
            <h3 class="value-heading">Complete Transparency</h3>
            <p class="value-desc">You retain full ownership of your domain, analytics, ad accounts, and source assets. Zero lock-in.</p>
          </div>
        </div>

        <div class="proof-grid">
          <div class="proof-sheet">
            <div class="proof-client-tag">Operational SLA</div>
            <div class="proof-metric-big">&lt;24h</div>
            <p class="proof-desc">Technical discovery turnaround. Rapid diagnostic response on incoming architecture reviews. <a href="/terms#onboarding-sla" class="proof-evidence-link">Terms § Onboarding SLA &rarr;</a></p>
          </div>
          <div class="proof-sheet">
            <div class="proof-client-tag">Commercial Policy</div>
            <div class="proof-metric-big">100%</div>
            <p class="proof-desc">Complete administrative client asset ownership. You hold DNS, analytics, and creative code directly. <a href="/terms#asset-ownership" class="proof-evidence-link">Terms § Asset Ownership &rarr;</a></p>
          </div>
          <div class="proof-sheet">
            <div class="proof-client-tag">Billing Transparency</div>
            <div class="proof-metric-big">Direct Billing</div>
            <p class="proof-desc">Direct platform billing on client ad spend. Direct payment through your own Google and Meta accounts. <a href="/terms#ad-billing" class="proof-evidence-link">Terms &sect; Ad Billing &rarr;</a></p>
          </div>
          <div class="proof-sheet">
            <div class="proof-client-tag">Simulator Integrity</div>
            <div class="proof-metric-big">Unit Model</div>
            <p class="proof-desc">Open benchmark formula. Transparent assumptions grounded in published industry medians. 
            <a href="/config/assumptions.json" target="_blank" class="proof-evidence-link">View Assumptions &rarr;</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <Faq />

  <!-- CONTACT & DISCOVERY AUDIT SECTION -->
  <section class="section-pad" id="contact" aria-label="Contact and Growth Audit Form">
    <div class="container">
      <div class="audit-split">
        
        <!-- Channels Left (Framed Executive Diagnostic Deck) -->
        <div class="frame-box audit-channels-deck">
          <div class="audit-channels-header">
            <span class="mono-label" style="color: var(--c-vermilion); display: block; margin-bottom: 0.25rem;">
              DIRECT EXECUTIVE COMMUNICATION
            </span>
            <h2 class="section-title audit-channels-title">Request a Growth Diagnostic</h2>
            <p class="section-desc audit-channels-desc">
              Connect directly with our lead growth engineering team. We review your current digital assets and provide actionable technical findings.
            </p>
          </div>

          <div class="channel-list">
            <a href="https://wa.me/918800592147?text=Hi%20SAPVIK%20team,%20I'd%20like%20to%20discuss%20a%20digital%20growth%20audit." target="_blank" rel="noopener" class="channel-card">
              <div class="channel-glyph">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              </div>
              <div class="channel-meta">
                <h4>Instant WhatsApp Connect</h4>
                <p>+91 88005 92147</p>
              </div>
            </a>

            <a href="mailto:growth@sapvik.com" class="channel-card">
              <div class="channel-glyph">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="channel-meta">
                <h4>Direct Email Inquiries</h4>
                <p>growth@sapvik.com</p>
              </div>
            </a>

            <div class="channel-card">
              <div class="channel-glyph">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="channel-meta">
                <h4>Operational Delivery</h4>
                <p>Pan-India & Global Delivery</p>
              </div>
            </div>
          </div>

          <div class="diagnostic-commitments">
            <span class="mono-label" style="display: block; margin-bottom: 0.65rem; color: var(--c-text-primary);">
              OPERATIONAL ENGAGEMENT SLA
            </span>
            <ul class="diagnostic-commitments-list">
              <li>
                <span class="bullet-tick">&bull;</span>
                <span><strong>&lt;24h Diagnostic SLA:</strong> Direct response from senior growth engineering leads.</span>
              </li>
              <li>
                <span class="bullet-tick">&bull;</span>
                <span><strong>100% Asset Ownership:</strong> You retain full DNS, code repositories, and ad account administration.</span>
              </li>
              <li>
                <span class="bullet-tick">&bull;</span>
                <span><strong>Confidential Data:</strong> Handled under strict commercial NDA protocols.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Form Right -->
        <ContactForm client:load />

      </div>
    </div>
  </section>

  <script>
    function initServicesCarousel() {
      const grid = document.getElementById('servicesGrid');
      const dots = document.querySelectorAll<HTMLButtonElement>('.services-scroll-dot');
      if (!grid || dots.length === 0) return;

      const panels = grid.querySelectorAll<HTMLElement>('.service-panel');
      if (panels.length === 0) return;

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          if (panels[idx]) {
            panels[idx].scrollIntoView({
              behavior: 'smooth',
              block: 'nearest',
              inline: 'center'
            });
          }
        });
      });

      let ticking = false;
      const updateActiveDot = () => {
        const gridRect = grid.getBoundingClientRect();
        const gridCenter = gridRect.left + gridRect.width / 2;

        let closestIdx = 0;
        let minDistance = Infinity;

        panels.forEach((panel, idx) => {
          const rect = panel.getBoundingClientRect();
          const panelCenter = rect.left + rect.width / 2;
          const dist = Math.abs(gridCenter - panelCenter);
          if (dist < minDistance) {
            minDistance = dist;
            closestIdx = idx;
          }
        });

        dots.forEach((dot, idx) => {
          const isActive = idx === closestIdx;
          dot.classList.toggle('active', isActive);
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        ticking = false;
      };

      grid.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateActiveDot);
          ticking = true;
        }
      }, { passive: true });

      updateActiveDot();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initServicesCarousel);
    } else {
      initServicesCarousel();
    }
  </script>
</Base>
