---
import Base from '../layouts/Base.astro';
import Scanner from '../components/islands/Scanner.tsx';

// Phase 5 Draft Route: Awaiting finalized copy and FAQs from company leadership (docs/CONTENT_INPUTS_NEEDED.md)
const draft = true;
---

<Base
  title="Free Website & Performance Audit | SAPVIK"
  description="Run a free technical and performance audit on any business website. Measure mobile speed, SSL configuration, and security headers instantly."
  loadTurnstile={true}
  noindex={draft}
>
  <div class="audit-page-section" style="padding-top: calc(var(--header-h) + 2.5rem); padding-bottom: 5rem;">
    <div class="container" style="max-width: 960px;">
      
      <!-- Draft Notice Banner -->
      <aside class="draft-indicator" aria-label="Draft Notice" style="margin-bottom: 2rem; background: #FFF9E6; border: 1px solid #FFE58F; padding: 0.85rem 1.25rem; font-size: 0.82rem; font-family: var(--font-mono); color: #874D00;">
        <strong>[DRAFT ROUTE &bull; NOINDEX]</strong> This standalone audit page layout is prepared and excluded from the sitemap pending company copy confirmation. Reference: <code>docs/CONTENT_INPUTS_NEEDED.md</code>.
      </aside>

      <!-- Section Header -->
      <header class="section-head" style="margin-bottom: 2.5rem; text-align: center;">
        <span class="badge" style="margin-bottom: 0.75rem;">DIAGNOSTIC CONSOLE</span>
        <h1 style="font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: var(--c-text-primary); margin-bottom: 0.75rem;">
          Instant Website Speed &amp; Security Diagnostic
        </h1>
        <p style="font-size: 1rem; color: var(--c-text-secondary); max-width: 680px; margin: 0 auto; line-height: 1.6;">
          Evaluate mobile latency, DNS security, SSL certificate encryption, and Core Web Vitals telemetry across live edge infrastructure.
        </p>
      </header>

      <!-- Scanner Island -->
      <div class="audit-scanner-wrapper" style="margin-bottom: 4rem;">
        <Scanner client:idle />
      </div>

      <!-- FAQ Slots Section (Awaiting Company Copy) -->
      <section class="audit-faqs frame-box" style="padding: 2rem;">
        <span class="mono-label" style="color: var(--c-vermilion); display: block; margin-bottom: 0.5rem;">
          AUDIT METHODOLOGY &amp; FAQS
        </span>
        <h2 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--c-text-primary); margin-bottom: 1.5rem;">
          Frequently Asked Questions About Website Diagnostics
        </h2>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="border-bottom: 1px dashed var(--c-border); padding-bottom: 1.25rem;">
            <h3 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--c-text-primary); margin-bottom: 0.4rem;">
              How are diagnostic scores calculated?
            </h3>
            <p style="font-size: 0.92rem; color: var(--c-text-secondary); line-height: 1.6; margin: 0;">
              Our edge probe assesses active TLS/SSL handshakes, HTTP security response headers, and DNS resolution, combined with real-device mobile Lighthouse telemetry from Google PageSpeed Insights.
            </p>
          </div>

          <div style="border-bottom: 1px dashed var(--c-border); padding-bottom: 1.25rem;">
            <h3 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--c-text-primary); margin-bottom: 0.4rem;">
              Is scanned domain data retained or shared?
            </h3>
            <p style="font-size: 0.92rem; color: var(--c-text-secondary); line-height: 1.6; margin: 0;">
              No. Scans are executed ephemerally in volatile server memory. Scanned targets are neither shared with third parties nor sold to data brokers.
            </p>
          </div>

          <div>
            <h3 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--c-text-primary); margin-bottom: 0.4rem;">
              What happens after running an audit?
            </h3>
            <p style="font-size: 0.92rem; color: var(--c-text-secondary); line-height: 1.6; margin: 0;">
              You can immediately review actionable technical findings and share the diagnostic report with your internal engineering team or request a strategic consultation.
            </p>
          </div>
        </div>
      </section>

    </div>
  </div>
</Base>
