---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../config/site';
import '../styles/styles.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  loadTurnstile?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title = "SAPVIK | Precision Digital Growth & Web Dev in India",
  description = "Custom high-speed web platforms, local Google Business Profile visibility, and commercial ad campaigns engineered for verified business growth.",
  canonical: passedCanonical,
  ogType = "website",
  loadTurnstile = false,
  noindex = false,
  schema
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://sapvik.com';
const ogImageUrl = `${siteUrl}/assets/og-image.png`;

// Normalize canonical URL to always be absolute, without .html, and with no trailing slash (except domain root)
let canonical: string;
if (passedCanonical) {
  let cleaned = passedCanonical.replace(/\.html$/, '');
  if (cleaned.endsWith('/index')) {
    cleaned = cleaned.slice(0, -6) || '/';
  }
  canonical = cleaned;
} else {
  let pathname = Astro.url.pathname.replace(/\.html$/, '');
  if (pathname === '/index' || pathname === '') {
    pathname = '/';
  }
  if (pathname.length > 1 && pathname.endsWith('/')) {
    pathname = pathname.slice(0, -1);
  }
  canonical = `${siteUrl}${pathname}`;
}

const socialProfiles = [
  SITE.brand.social?.linkedin,
  SITE.brand.social?.instagram,
  SITE.brand.social?.facebook,
  SITE.brand.social?.twitter
].filter((url): url is string => Boolean(url && url.trim().length > 0));

// Organization / ProfessionalService Schema
const organizationSchema: Record<string, any> = {
  "@type": ["Organization", "ProfessionalService"],
  "@id": "https://sapvik.com/#organization",
  "name": SITE.brand.name,
  "url": "https://sapvik.com",
  "logo": {
    "@type": "ImageObject",
    "@id": "https://sapvik.com/#logo",
    "url": "https://sapvik.com/assets/logo.png",
    "contentUrl": "https://sapvik.com/assets/logo.png",
    "caption": "SAPVIK - Precision Digital Growth Partner"
  },
  "image": ogImageUrl,
  "description": "Website development, Google Business Profile management, paid advertising, and commercial digital marketing partner in India.",
  "telephone": SITE.brand.phone,
  "email": SITE.brand.email,
  ...(socialProfiles.length > 0 ? { "sameAs": socialProfiles } : {}),
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.brand.streetAddress,
    "addressLocality": SITE.brand.locality,
    "addressRegion": SITE.brand.region,
    "postalCode": SITE.brand.postalCode,
    "addressCountry": "IN"
  },
  "founder": {
    "@type": "Person",
    "name": SITE.brand.founder,
    "email": SITE.brand.founderEmail
  },
  "areaServed": {
    "@type": "Country",
    "name": "India"
  },
  "priceRange": "$$"
};

const rawGtmId = (import.meta.env.PUBLIC_GTM_ID || '').trim();
const gtmId = /^GTM-[A-Z0-9]+$/.test(rawGtmId) ? rawGtmId : null;

// Combine organization schema with page-specific schema
const graphItems = [organizationSchema];
if (schema) {
  if (Array.isArray(schema)) {
    graphItems.push(...schema);
  } else {
    graphItems.push(schema);
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graphItems
};
---

<!DOCTYPE html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#12161C" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="alternate" type="application/rss+xml" title="SAPVIK Insights" href="/rss.xml" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="SAPVIK" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="SAPVIK - Website Development & Digital Marketing in India" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Preload Critical Above-the-Fold Self-Hosted Fonts -->
  <link rel="preload" href="/assets/fonts/archivo-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-400-normal.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Favicons & App Icons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <!-- Google Consent Mode v2 Default (denied for non-essential storage) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied'
    });
  </script>

  <!-- Google Tag Manager Snippet: Defer until user interaction or load + idle fallback -->
  {gtmId && (
    <script is:inline define:vars={{ gtmId }}>
      (function(w,d,s,l,i){
        w[l]=w[l]||[];
        w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
        var loaded = false;
        function loadGtm() {
          if (loaded) return;
          loaded = true;
          events.forEach(function(e) { w.removeEventListener(e, onInteract, { passive: true }); });
          var f = d.getElementsByTagName(s)[0];
          var j = d.createElement(s);
          var dl = l !== 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        }
        var events = ['scroll', 'click', 'keydown', 'touchstart'];
        function onInteract() {
          loadGtm();
        }
        events.forEach(function(e) { w.addEventListener(e, onInteract, { once: true, passive: true }); });
        w.addEventListener('load', function() {
          if ('requestIdleCallback' in w) {
            w.requestIdleCallback(function() { setTimeout(loadGtm, 1500); }, { timeout: 3500 });
          } else {
            setTimeout(loadGtm, 3500);
          }
        }, { once: true });
      })(window,document,'script','dataLayer',gtmId);
    </script>
  )}
</head>
<body>
  <!-- Google Tag Manager (noscript fallback - rendered strictly when valid PUBLIC_GTM_ID is configured) -->
  {gtmId && (
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  )}

  <!-- Accessible Skip to Main Content Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <ConsentBanner />
</body>
</html>
