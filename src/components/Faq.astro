---
const FAQS = [
  {
    q: "What services does SAPVIK provide?",
    a: "SAPVIK operates across six core growth capabilities: Website Development, Google Business Profile Management, Search Engine Optimization (SEO), Google Ads & Meta Ads, Social Media Management, and Custom Application Development. We can manage the complete digital ecosystem or execute targeted high-priority initiatives."
  },
  {
    q: "How quickly can we see results with GMB Management?",
    a: "Most businesses begin seeing citation indexing and ranking movement within 30 to 60 days, with top-3 local positions developing across 60 to 90 days depending on local market competition."
  },
  {
    q: "What is the turnaround time for discovery audits?",
    a: "Our technical strategists review submitted websites and respond with tailored architecture findings within 24 business hours."
  },
  {
    q: "How does SAPVIK report on ROI and campaign performance?",
    a: "We provide bi-weekly performance debriefs focused on verified business metrics: cost-per-acquisition, verified inbound calls, and closed revenue attribution."
  }
];
---

<!-- FAQ SECTION -->
<section class="section-pad" id="faq" aria-label="Frequently Asked Questions">
  <div class="container">
    <div class="section-head" style="text-align: center;">
      <span class="mono-label">Clarity & Answers</span>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-desc" style="margin-left: auto; margin-right: auto;">
        Straightforward answers about our deliverables, pricing structure, and execution timelines.
      </p>
    </div>

    <div class="faq-stack">
      {FAQS.map((item, idx) => (
        <div class="faq-row">
          <button type="button" class="faq-trigger" aria-expanded="false" id={`faq-btn-${idx}`}>
            <span>{item.q}</span>
            <span class="faq-indicator">+</span>
          </button>
          <div class="faq-content">
            <div>
              {item.a}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initFaq() {
    const triggers = document.querySelectorAll('.faq-trigger');
    triggers.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.faq-row');
        const isOpen = btn.getAttribute('aria-expanded') === 'true';

        // Close other rows
        triggers.forEach((otherBtn) => {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            otherBtn.closest('.faq-row')?.classList.remove('active');
          }
        });

        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          row?.classList.remove('active');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          row?.classList.add('active');
          if (window.dataLayer) {
            window.dataLayer.push({ event: 'faq_open', faq_id: `faq_${idx}` });
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaq);
  } else {
    initFaq();
  }
</script>
