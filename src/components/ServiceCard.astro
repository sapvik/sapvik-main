---
import type { ServiceItem } from '../config/services';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const outcomeMap: Record<string, string> = {
  'websites': 'Higher Conversion Rate & Speed',
  'gmb': 'Inbound Local Calls & Discovery',
  'seo': 'Organic Search Impressions & Rankings',
  'promotions': 'Qualified Commercial Leads',
  'media': 'Brand Trust & Audience Reach',
  'apps': 'Workflow Efficiency & Hours Saved'
};
---

<article class="frame-box service-panel" id={`service-${service.id}`}>
  <div>
    <div class="service-header-row">
      <span class="service-code">{service.code}</span>
      {service.id === 'websites' && (
        <svg class="service-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      )}
      {service.id === 'gmb' && (
        <svg class="service-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      )}
      {service.id === 'seo' && (
        <svg class="service-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      )}
      {service.id === 'media' && (
        <svg class="service-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23 7l-7 5 7 5V7z"></path>
          <rect x="1" y="5" width="15" height="14" rx="2"></rect>
        </svg>
      )}
      {service.id === 'promotions' && (
        <svg class="service-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
      )}
      {service.id === 'apps' && (
        <svg class="service-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      )}
    </div>
    <h3 class="service-title">
      <a href={`/services/${service.slug}`} style="color: inherit; text-decoration: none;">
        {service.name}
      </a>
    </h3>
    <p class="service-narrative">
      {service.description}
    </p>
    <ul class="service-deliverables">
      {service.deliverables.map((item) => (
        <li class="deliverable-item">
          <span class="item-dash">—</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="service-kpi-footer">
    <div class="service-kpi-meta">
      <span class="mono-label">PRIMARY OUTCOME: </span>
      <span class="service-kpi-val">{outcomeMap[service.id] || service.metricsFocus}</span>
    </div>
    <a href={`/services/${service.slug}`} class="btn btn-orange btn-vermilion btn-sm service-explore-btn">
      <span>Explore</span>
      <span>&rarr;</span>
    </a>
  </div>
</article>
