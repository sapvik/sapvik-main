<!-- EXECUTION PROCESS (4 STAGES) -->
<section class="section-pad" id="process" aria-label="Our Process">
  <div class="container">
    <div class="section-head">
      <span class="mono-label">Systematic Delivery</span>
      <h2 class="section-title">How We Partner & Execute</h2>
      <p class="section-desc">
        Disciplined four-stage execution designed to eliminate guesswork and deliver measurable business outcomes.
      </p>
    </div>

    <div class="process-columns">
      
      <div class="frame-box process-step-box">
        <span class="process-step-num">STAGE 01</span>
        <h3 class="process-step-title">Forensic Audit</h3>
        <p class="process-step-text">
          We analyze your current site speed, local search rank radii, past ad performance, and competitor bottlenecks to establish a verified baseline.
        </p>
      </div>

      <div class="frame-box process-step-box">
        <span class="process-step-num">STAGE 02</span>
        <h3 class="process-step-title">Foundation Sprint</h3>
        <p class="process-step-text">
          We deploy your high-speed website, clean up local NAP citations, structure Google Business Profile categories, and set up tracking pixels.
        </p>
      </div>

      <div class="frame-box process-step-box">
        <span class="process-step-num">STAGE 03</span>
        <h3 class="process-step-title">Scale & Acquire</h3>
        <p class="process-step-text">
          We launch targeted Google Search and Meta direct-response campaigns to bring in ready-to-buy inquiries and expand local map rankings.
        </p>
      </div>

      <div class="frame-box process-step-box">
        <span class="process-step-num">STAGE 04</span>
        <h3 class="process-step-title">Optimize & Scale</h3>
        <p class="process-step-text">
          Bi-weekly data debriefs. We eliminate wasted ad spend, refine conversion funnels, and scale high-performing acquisition channels.
        </p>
      </div>

    </div>
  </div>
</section>
