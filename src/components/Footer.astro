---
import { SITE } from '../config/site';
import { SERVICES } from '../config/services';
---

<!-- SITE FOOTER -->
<footer class="site-footer">
  <div class="container">
    
    <div class="footer-matrix">
      
      <!-- Brand Info -->
      <div class="footer-meta-block">
        <a href="/#home" aria-label="SAPVIK Homepage">
          <img src="/assets/logo.svg?v=3" alt="SAPVIK Logo - Build. Be Seen. Grow." class="brand-logo-img" width="180" height="42">
        </a>
        <p style="margin-top: 1rem; color: var(--c-text-secondary); line-height: 1.6; font-size: 0.95rem;">
          Precision digital growth partner for ambitious businesses. Website Development, Google Business Profile Management, SEO, Google & Meta Ads, Social Media, Applications, and Branding.
        </p>
        <div style="margin-top: 1.25rem;">
          <span class="mono-label" style="color: var(--c-vermilion); font-weight: 700;">Sharper digital. Stronger business.</span>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="footer-nav-title">Growth Services</h4>
        <ul class="footer-nav-list">
          {SERVICES.map((s) => (
            <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="footer-nav-title">Explore</h4>
        <ul class="footer-nav-list">
          <li><a href="/#services">All Services</a></li>
          <li><a href="/#heatmap">Local Heatmap Simulator</a></li>
          <li><a href="/#calculator">Growth Simulator</a></li>
          <li><a href="/#process">4-Stage Process</a></li>
          <li><a href="/#proof">Client Proof & SLAs</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/#contact">Request Growth Audit</a></li>
        </ul>
      </div>

      <!-- Connect & Compliance -->
      <div>
        <h4 class="footer-nav-title">Connect</h4>
        <ul class="footer-nav-list">
          <li><a href={`https://wa.me/${SITE.brand.whatsappNumber}?text=${encodeURIComponent(SITE.brand.whatsappText)}`} target="_blank" rel="noopener">WhatsApp Direct</a></li>
          <li><a href={`mailto:${SITE.brand.email}`}>{SITE.brand.email}</a></li>
          <li><a href={SITE.brand.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={SITE.brand.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="/sitemap.xml">XML Sitemap</a></li>
        </ul>
      </div>

    </div>

    <!-- Legal Compliance Bottom Bar -->
    <div class="footer-bottom-bar">
      <div>
        &copy; 2026 SAPVIK Tech. All rights reserved. Precision digital systems for commercial scale across India.
      </div>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/cookies">Cookie Disclosure</a>
        <button type="button" id="footerConsentReset" class="consent-reset-link" style="background: none; border: none; color: inherit; font: inherit; cursor: pointer; text-decoration: underline; padding: 0;">Cookie Settings</button>
      </div>
    </div>

  </div>
</footer>

<!-- STICKY MOBILE ACTION DOCK (TWO HIGH-CONTRAST TOUCH ACTIONS) -->
<aside class="mobile-bottom-dock" id="mobileBottomDock" aria-label="Quick Actions">
  <a href={`https://wa.me/${SITE.brand.whatsappNumber}?text=${encodeURIComponent(SITE.brand.whatsappText)}`} target="_blank" rel="noopener" class="dock-btn dock-btn-whatsapp">
    <span>WhatsApp Direct</span>
  </a>
  <a href="/#contact" class="dock-btn dock-btn-audit">
    <span>Claim Free Audit</span>
  </a>
</aside>

<script>
  function initFooterConsent() {
    const resetBtn = document.getElementById('footerConsentReset');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('sapvik:open-consent'));
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterConsent);
  } else {
    initFooterConsent();
  }
</script>
