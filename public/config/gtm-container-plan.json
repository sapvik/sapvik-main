{
  "exportFormatVersion": 2,
  "description": "GTM Container Plan for SAPVIK: Maps dataLayer custom events to Google Analytics 4 tags with Consent Mode v2 triggers",
  "containerVersion": {
    "tag": [
      {
        "name": "GA4 - Google tag (Configuration)",
        "type": "googtag",
        "parameter": [
          { "key": "tagId", "value": "{{GA4 Measurement ID}}" },
          { "key": "consentSettings", "value": { "analytics_storage": "needed", "ad_storage": "needed" } }
        ],
        "firingTriggerId": ["Initialization - All Pages"]
      },
      {
        "name": "GA4 Event - Generate Lead",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "generate_lead" },
          { "key": "eventParameters", "value": [
            { "name": "service", "value": "{{dlv - service}}" },
            { "name": "lead_id", "value": "{{dlv - lead_id}}" },
            { "name": "source", "value": "{{dlv - source}}" }
          ]}
        ],
        "firingTriggerId": ["Custom Event - generate_lead"]
      },
      {
        "name": "GA4 Event - Scan Start",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "scan_start" },
          { "key": "eventParameters", "value": [{ "name": "target_scheme", "value": "{{dlv - target_scheme}}" }] }
        ],
        "firingTriggerId": ["Custom Event - scan_start"]
      },
      {
        "name": "GA4 Event - Scan Complete",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "scan_complete" },
          { "key": "eventParameters", "value": [
            { "name": "response_time_ms", "value": "{{dlv - response_time_ms}}" },
            { "name": "has_ssl", "value": "{{dlv - has_ssl}}" },
            { "name": "findings_count", "value": "{{dlv - findings_count}}" }
          ]}
        ],
        "firingTriggerId": ["Custom Event - scan_complete"]
      },
      {
        "name": "GA4 Event - Scan Error",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "scan_error" },
          { "key": "eventParameters", "value": [{ "name": "error_code", "value": "{{dlv - error_code}}" }] }
        ],
        "firingTriggerId": ["Custom Event - scan_error"]
      },
      {
        "name": "GA4 Event - Calculator Interact",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "calc_interact" },
          { "key": "eventParameters", "value": [
            { "name": "budget_tier", "value": "{{dlv - budget_tier}}" },
            { "name": "service_toggled", "value": "{{dlv - service_toggled}}" }
          ]}
        ],
        "firingTriggerId": ["Custom Event - calc_interact"]
      },
      {
        "name": "GA4 Event - Calculator Claim",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "calc_claim" },
          { "key": "eventParameters", "value": [
            { "name": "budget_tier", "value": "{{dlv - budget_tier}}" },
            { "name": "industry_key", "value": "{{dlv - industry_key}}" }
          ]}
        ],
        "firingTriggerId": ["Custom Event - calc_claim"]
      },
      {
        "name": "GA4 Event - Heatmap Toggle",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "heatmap_toggle" },
          { "key": "eventParameters", "value": [
            { "name": "rank", "value": "{{dlv - rank}}" },
            { "name": "node_id", "value": "{{dlv - node_id}}" }
          ]}
        ],
        "firingTriggerId": ["Custom Event - heatmap_toggle"]
      },
      {
        "name": "GA4 Event - FAQ Open",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "faq_open" },
          { "key": "eventParameters", "value": [{ "name": "question_id", "value": "{{dlv - question_id}}" }] }
        ],
        "firingTriggerId": ["Custom Event - faq_open"]
      },
      {
        "name": "GA4 Event - WhatsApp Click",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "click_whatsapp" },
          { "key": "eventParameters", "value": [{ "name": "location", "value": "{{dlv - location}}" }] }
        ],
        "firingTriggerId": ["Custom Event - click_whatsapp"]
      },
      {
        "name": "GA4 Event - Call Click",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "click_call" },
          { "key": "eventParameters", "value": [{ "name": "location", "value": "{{dlv - location}}" }] }
        ],
        "firingTriggerId": ["Custom Event - click_call"]
      },
      {
        "name": "GA4 Event - Email Click",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "click_email" },
          { "key": "eventParameters", "value": [{ "name": "location", "value": "{{dlv - location}}" }] }
        ],
        "firingTriggerId": ["Custom Event - click_email"]
      },
      {
        "name": "GA4 Event - Form Start",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "form_start" },
          { "key": "eventParameters", "value": [{ "name": "form_id", "value": "{{dlv - form_id}}" }] }
        ],
        "firingTriggerId": ["Custom Event - form_start"]
      },
      {
        "name": "GA4 Event - Form Error",
        "type": "gaawe",
        "parameter": [
          { "key": "eventName", "value": "form_error" },
          { "key": "eventParameters", "value": [
            { "name": "form_id", "value": "{{dlv - form_id}}" },
            { "name": "error_field", "value": "{{dlv - error_field}}" }
          ]}
        ],
        "firingTriggerId": ["Custom Event - form_error"]
      }
    ],
    "trigger": [
      { "name": "Custom Event - generate_lead", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "generate_lead" }] },
      { "name": "Custom Event - scan_start", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "scan_start" }] },
      { "name": "Custom Event - scan_complete", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "scan_complete" }] },
      { "name": "Custom Event - scan_error", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "scan_error" }] },
      { "name": "Custom Event - calc_interact", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "calc_interact" }] },
      { "name": "Custom Event - calc_claim", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "calc_claim" }] },
      { "name": "Custom Event - heatmap_toggle", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "heatmap_toggle" }] },
      { "name": "Custom Event - faq_open", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "faq_open" }] },
      { "name": "Custom Event - click_whatsapp", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "click_whatsapp" }] },
      { "name": "Custom Event - click_call", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "click_call" }] },
      { "name": "Custom Event - click_email", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "click_email" }] },
      { "name": "Custom Event - form_start", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "form_start" }] },
      { "name": "Custom Event - form_error", "type": "customEvent", "customEventFilter": [{ "type": "equals", "arg0": "_event", "arg1": "form_error" }] }
    ]
  }
}
